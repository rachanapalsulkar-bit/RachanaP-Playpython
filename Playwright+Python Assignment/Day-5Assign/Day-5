from playwright.sync_api import sync_playwright, expect

class LoginPage:
    def __init__(self, page):
        self.page = page
        self.user = "#user-name"
        self.pwd = "#password"
        self.btn = "#login-button"

    def login(self, u, p):
        self.page.fill(self.user, u)
        self.page.fill(self.pwd, p)
        self.page.click(self.btn)

with sync_playwright() as p:
    browser = p.chromium.launch(headless=False)
    page = browser.new_page()

    page.goto("https://www.saucedemo.com")
    login = LoginPage(page)
    login.login("standard_user", "secret_sauce")
    assert "inventory" in page.url
    print("Login Successful")
    page.wait_for_timeout(3000)

    # Verify Product Count
    count = page.locator(".inventory_item").count()
    assert count >= 6
    print("Products Available:", count)

    # Add Products
    page.click("#add-to-cart-sauce-labs-backpack")
    page.click("#add-to-cart-sauce-labs-bike-light")
    expect(page.locator(".shopping_cart_badge")).to_have_text("2")
    print("2 Products Added")

    # Remove One Product
    page.click("#remove-sauce-labs-backpack")
    expect(page.locator(".shopping_cart_badge")).to_have_text("1")
    print("1 Product Removed")

    # Logout
    page.click("#react-burger-menu-btn")      # Open menu
    page.click("#logout_sidebar_link")        # Click Logout

    # Verify Login Page
    expect(page.locator("#user-name")).to_be_visible()
    expect(page.locator("#password")).to_be_visible()
    expect(page.locator("#login-button")).to_be_visible()
    page.wait_for_timeout=(1000)

    print("Logout Successful")

    browser.close()

